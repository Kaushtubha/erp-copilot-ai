# =============================================================================
# ERP Copilot AI — Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# ─────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────
POSTGRES_DB=erp_copilot
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=erp_password_secure_2024
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ─────────────────────────────────────────────
# REDIS
# ─────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_password_secure_2024

# ─────────────────────────────────────────────
# SPRING BOOT
# ─────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=docker
JWT_SECRET=your-super-secret-jwt-key-at-least-256-bits-long-please-change-this
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─────────────────────────────────────────────
# FASTAPI AI SERVICE
# ─────────────────────────────────────────────
BACKEND_BASE_URL=http://backend:8080
AI_SERVICE_PORT=8000

# ─────────────────────────────────────────────
# LLM PROVIDERS (at least one required)
# ─────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Primary LLM provider: gemini | openai | anthropic | groq
PRIMARY_LLM_PROVIDER=gemini
PRIMARY_LLM_MODEL=gemini-2.0-flash

# ─────────────────────────────────────────────
# QDRANT VECTOR DATABASE
# ─────────────────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=

# ─────────────────────────────────────────────
# EMBEDDING MODEL
# ─────────────────────────────────────────────
EMBEDDING_MODEL=models/text-embedding-004
EMBEDDING_DIMENSION=768

# ─────────────────────────────────────────────
# FRONTEND
# ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=ERP Copilot AI

# ─────────────────────────────────────────────
# NGINX
# ─────────────────────────────────────────────
NGINX_PORT=80
NGINX_SSL_PORT=443

# ─────────────────────────────────────────────
# FEATURE FLAGS
# ─────────────────────────────────────────────
ENABLE_VOICE_INPUT=true
ENABLE_PDF_EXPORT=true
ENABLE_WORKFLOW_AUTOMATION=true
ENABLE_FORECASTING=true
ENABLE_MULTI_LLM=true
